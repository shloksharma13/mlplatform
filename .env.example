# Runtime identity
SERVICE_NAME=model-api
LOG_LEVEL=INFO

# Model and feature providers (P1 local defaults)
MODEL_NAME=loan-default
MODEL_VERSION=1
MODEL_SOURCE=file
FEATURE_SOURCE=parquet

# Local platform endpoints; never put real credentials in this file
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
FEAST_S3_ENDPOINT_URL=http://localhost:9000
DATABASE_URL=
REDIS_URL=redis://localhost:6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Demo safety defaults
ENABLE_CHAOS=false
TRIGGER_MODE=local
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=

# Drift detection and retraining (SPEC 5.4; P8)
DRIFT_INTERVAL_SECONDS=60
DRIFT_WINDOW_SIZE=1000
DRIFT_MIN_SAMPLES=500
DRIFT_PSI_THRESHOLD=0.25
DRIFT_KS_D_THRESHOLD=0.2
DRIFT_KS_P=0.01
DRIFT_MIN_FEATURES=2
DRIFT_CONSECUTIVE=2
RETRAIN_COOLDOWN_SECONDS=300
